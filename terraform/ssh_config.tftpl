Host ctf-haproxy
  Hostname ${connection_ip}
  User root
  IdentityFile ~/.ssh/id_rsa

Host ctf-gameserver
  Hostname ctf-gameserver
  User root
  IdentityFile ~/.ssh/id_rsa
  ProxyJump ctf-haproxy

%{ for item_key, item_value in items ~}
Host ${item_value.name}
  Hostname ${item_value.name}
  User root
  IdentityFile ~/.ssh/id_rsa
  ProxyJump ctf-haproxy

%{ endfor ~}
