Host ctf-haproxy
  Hostname ${haproxy.connection_ip}
  User root
  IdentityFile ~/.ssh/id_rsa

Host ctf-gameserver
  Hostname ${gameserver.name}
  User root
  IdentityFile ~/.ssh/id_rsa
  %{~ if is_public_ip ~}
  ProxyJump ctf-haproxy
  %{~ endif ~}

Host ctf-developer
  Hostname ${developer.name}
  User root
  IdentityFile ~/.ssh/id_rsa
  %{~ if is_public_ip ~}
  ProxyJump ctf-haproxy
  %{~ endif ~}

%{ for item_key, item_value in items ~}
Host ${item_value.name}
  Hostname ${item_value.name}
  User root
  IdentityFile ~/.ssh/id_rsa
  %{~ if is_public_ip ~}
  ProxyJump ctf-haproxy
  %{~ endif ~}

%{ endfor ~}
