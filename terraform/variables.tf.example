locals {
  opennebula = {
    connection = {
      username = "ctf"
      group    = "ctf"
      token    = "4b8cf5....................................................c1cb11"
    }
    vm = {
      tag         = "debian-terraform"
      tag_desktop = "debian-terraform-desktop"
      locked      = false
    }
    limits = {
      gameserver = {
        cpu    = 2
        vcpu   = 4
        memory = 2048
        disk   = 8192
      }
      nodes = {
        cpu    = 1
        vcpu   = 2
        memory = 2048
        disk   = 8192
      }
      subs = {
        cpu    = 0.25
        vcpu   = 2
        memory = 256
        disk   = 4096
      }
      haproxy = {
        cpu    = 2
        vcpu   = 4
        memory = 512
        disk   = 4096
      }
      developer = {
        cpu    = 1
        vcpu   = 2
        memory = 2048
        disk   = 16384
      }
    }
    network_prefix      = "172.20.228"
    public_network_ip   = "172.20.227.240"
    public_network_size = "5"
  }
  ansible = {
    connect_to_public_ip = false
  }
}

variable "nodes" {
  description = "Número de equipos"
  default     = 2
}

variable "SSH_PUBLIC_KEY" {
  type        = string
  description = "Clave pública del usuario para inyectar en las máquinas OpenNebula"
}
