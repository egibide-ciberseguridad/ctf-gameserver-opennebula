locals {
  opennebula = {
    connection = {
      username = "ctf"
      group    = "ctf"
      token    = "4b8cf5....................................................c1cb11"
    }
    vm = {
      tag     = "debian-terraform"
      tag_desktop = "debian-terraform-desktop"
      network = "ciber-xx"
      locked  = false
    }
    limits = {
      gameserver = {
        cpu    = 2
        vcpu   = 4
        memory = 4096
        disk   = 16384
      }
      nodes = {
        cpu    = 1
        vcpu   = 2
        memory = 2048
        disk   = 8192
      }
      subs = {
        cpu    = 0.5
        vcpu   = 2
        memory = 512
        disk   = 4096
      }
      haproxy = {
        cpu    = 1
        vcpu   = 2
        memory = 1024
        disk   = 8192
      }
      developer = {
        cpu    = 2
        vcpu   = 4
        memory = 4096
        disk   = 16384
      }
    }
    network_prefix = "172.20.227"
  }
  ansible = {
    connect_to_public_ip = false
  }
}

variable "nodes" {
  description = "Número de equipos"
  default     = 2
}

variable "SSH_PUBLIC_KEY" {
  type        = string
  description = "Clave pública del usuario para inyectar en las máquinas OpenNebula"
}
